---
import Base from "../layouts/Base.astro";
import market from "../data/market.json";
import { pct } from "../lib/fmt.js";

const rows = [
  ["KOSPI", market.kospi],
  ["KOSDAQ", market.kosdaq],
];
---
<Base
  title="Korean Market Snapshot — KOSPI & KOSDAQ | Chip & Cell"
  description="Daily KOSPI and KOSDAQ index snapshot: closing level, day change and 20-day return, as context for Korea's semiconductor and battery sectors."
>
  <h1>Market</h1>
  <p class="asof">As of {market.asof} (Seoul close)</p>
  <div class="table-scroll">
    <table>
      <thead>
        <tr><th>Index</th><th>Close</th><th>Day</th><th>20-day</th></tr>
      </thead>
      <tbody>
        {rows.map(([name, m]) => {
          const day = pct(m.pct);
          const r20 = pct(m.r20);
          return (
            <tr>
              <td>{name}</td>
              <td>{m.close.toLocaleString("en-US")}</td>
              <td><span class={day.cls}>{day.text}</span></td>
              <td><span class={r20.cls}>{r20.text}</span></td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
  <p>
    Index levels frame the sector tables: see <a href="/semiconductor/">semiconductor</a> and
    <a href="/battery/">battery</a> for the stock-level picture.
  </p>
</Base>
